{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      },
      "environment": "production",
      "channel": "development"
    },
    "preview": {
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      },
      "env": {
        "EAS_BUILD_ANDROID_ABIS": "arm64-v8a"
      },
      "environment": "production",
      "channel": "preview"
    },
    "production": {
      "env": {
        "EAS_BUILD_ANDROID_ABIS": "arm64-v8a"
      },
      "environment": "production",
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.13",
    "expo-image-picker": "~56.0.25",
    "expo-linking": "~56.0.18",
    "expo-modules-core": "~56.0.27",
    "expo-router": "~56.2.21",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",

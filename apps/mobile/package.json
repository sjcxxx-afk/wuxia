    "patch-package": "^8.0.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.14",
    "@expo/vector-icons": "^15.0.3",
    "@zhanziyang/expo-text-extractor": "^1.0.2",
    "expo": "~56.0.23",
    "expo-constants": "~56.0.27",
    "expo-dev-client": "~56.0.27",

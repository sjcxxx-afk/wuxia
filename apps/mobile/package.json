    "check:theme": "node scripts/check-theme-contrast.js",
    "check:textures": "node scripts/generate-textures.js --check",
    "check:babel": "node scripts/probe-worklets.js",
    "check:imports": "node scripts/check-import-exports.js",
    "check:icons": "node scripts/icon-preview.js --check",
    "check:native": "node scripts/check-native-resources.js",
    "icons:preview": "node scripts/icon-preview.js",
    "generate:textures": "node scripts/generate-textures.js",
    "generate:icons": "node scripts/icons.js",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",

{
  "version": "1.0.0",
  "name": "wuxia",
  "scripts": {
    "ios": "expo run:ios",
    "android": "expo run:android",
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
